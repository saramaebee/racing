# Copy to .env and fill in. Bun loads .env automatically.

# Port the server listens on (Caddy reverse-proxies to this).
PORT=3000

# Shared password required to create championships and enter/edit scores.
# Anyone with this can edit; viewing is always public.
EDIT_PASSWORD=changeme

# Secret used to sign the editor session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=dev-insecure-secret-change-me

# Where the SQLite database file lives.
DATABASE_PATH=./data/racing.db
